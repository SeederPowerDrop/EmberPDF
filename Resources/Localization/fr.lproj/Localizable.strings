/* About */
"about.menu" = "À propos de EmberPDF";
"about.title" = "À propos de EmberPDF";
"about.close" = "Fermer";
"about.confirm" = "Fermer";
"about.github" = "GitHub · SeederPowerDrop";
"about.support" = "Soutenir EmberPDF";
"about.introduction.1" = "Une application de lecture et d’édition de PDF que j’avais payée cher est passée à un modèle d’abonnement, et je ne pouvais plus utiliser les fonctions dont je me servais jusque-là. Cela m’a mis en colère, alors j’ai créé EmberPDF en vibe coding.";
"about.introduction.2" = "J’ai donc commencé à la créer sous le coup de la colère, mais sans m’en rendre compte, ce sentiment s’est calmé, comme un feu réduit à des braises. Je me suis dit que beaucoup de personnes avaient sans doute vécu la même chose. J’ai créé cette application en espérant qu’elle serait maintenue longtemps pour ces personnes.";
"about.introduction.3" = "J’ai aussi ajouté des extensions, avec l’envie de créer un équivalent d’Obsidian pour les PDF. J’espère que chacun pourra ajouter les fonctions dont il a besoin et que nous élargirons ensemble les possibilités.";
"about.introduction.4" = "J’espère qu’EmberPDF sera utile à tous pendant longtemps, comme une braise qui garde sa chaleur. Je continuerai à le partager gratuitement et à en prendre soin aussi longtemps que je le pourrai.";
"about.introduction.5" = "Merci.\nEt ERW FWS WRG";
"about.support.title" = "Soutenir le projet";
"about.support.detail" = "Je crée des outils gratuits pour tous, dans l’esprit de transmettre l’aide que j’ai reçue. Si EmberPDF vous a été utile, un petit don peut soutenir son développement et sa maintenance.";
"about.image_accessibility" = "Illustration de personnage en noir et blanc fournie par le créateur";
"about.image_unavailable" = "Impossible de charger l’illustration de présentation";
"about.tagline" = "Un outil PDF pour macOS que chacun peut utiliser librement.";
"about.guide" = "Guide d’utilisation";
"about.rights.title" = "Droits fondamentaux liés aux logiciels";
"about.rights.detail" = "Je pense que chacun devrait pouvoir utiliser librement et gratuitement les outils informatiques essentiels. J’espère que le savoir que nous partageons sera un point de départ pour d’autres, et que les humains et l’IA pourront apprendre, créer et ouvrir de nouvelles possibilités ensemble.";
"about.licenses" = "Licences open source";
"about.licenses.detail" = "EmberPDF est distribué sous la Mozilla Public License 2.0. Vous pouvez également consulter les licences et les mentions de droits d’auteur des composants open source utilisés.";
