/* About */
"about.menu" = "Acerca de EmberPDF";
"about.title" = "Acerca de EmberPDF";
"about.close" = "Cerrar";
"about.confirm" = "Aceptar";
"about.github" = "GitHub · SeederPowerDrop";
"about.support" = "Apoyar EmberPDF";
"about.introduction.1" = "Una aplicación para leer y editar PDF por la que había pagado mucho dinero pasó a un modelo de suscripción, y ya no pude usar las funciones que utilizaba hasta entonces. Me enfadé, así que creé EmberPDF mediante vibe coding.";
"about.introduction.2" = "Así empecé a crearla por enfado, pero, sin darme cuenta, aquel sentimiento se fue calmando como un fuego que queda en brasas. Pensé que debía de haber muchas personas que habían pasado por lo mismo. Creé la aplicación con la esperanza de que siguiera manteniéndose durante mucho tiempo para esas personas.";
"about.introduction.3" = "También añadí complementos, con la ilusión de crear algo así como Obsidian para los PDF. Ojalá cada uno pueda añadir las funciones que necesita y podamos ampliar juntos las posibilidades.";
"about.introduction.4" = "Espero que EmberPDF resulte útil para todos durante muchos años, como una brasa que conserva su calor. Seguiré compartiéndola gratis y cuidándola durante todo el tiempo que pueda.";
"about.introduction.5" = "Gracias.\nY ERW FWS WRG";
"about.support.title" = "Apoyar el proyecto";
"about.support.detail" = "Creo herramientas que todos puedan usar gratis, con la intención de devolver la ayuda que he recibido. Si EmberPDF te ha resultado útil, una pequeña donación puede apoyar su desarrollo y mantenimiento.";
"about.image_accessibility" = "Ilustración de personaje en blanco y negro proporcionada por el creador";
"about.image_unavailable" = "No se pudo cargar la imagen de presentación";
"about.tagline" = "Una herramienta PDF para macOS que todos pueden usar libremente.";
"about.guide" = "Guía de uso";
"about.rights.title" = "Derechos básicos sobre el software";
"about.rights.detail" = "Creo que todos deberían poder usar las herramientas informáticas esenciales libremente y sin coste. Espero que el conocimiento que compartimos sea un punto de partida para otros y que las personas y la IA puedan aprender, crear y abrir nuevas posibilidades juntas.";
"about.licenses" = "Licencias de código abierto";
"about.licenses.detail" = "EmberPDF se distribuye bajo la Mozilla Public License 2.0. También puedes consultar las licencias y los avisos de derechos de autor de los componentes de código abierto que utiliza.";
